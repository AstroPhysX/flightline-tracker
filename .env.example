# Copy to .env only for local docker-compose use. In Portainer these can be stack variables.
TRACKER_IMAGE=ghcr.io/YOUR_GITHUB_USER/flightline-tracker:stable
TRACKER_PORT=8765
TRACKER_DATA_PATH=/volume1/docker/flightline-tracker/data
ADMIN_PASSWORD=choose-a-strong-admin-password

# auto = Secure on HTTPS, usable over HTTP for LAN testing
ADMIN_COOKIE_SECURE=auto

# Optional cap for the small replay-weather archive.
# v27 stores up to 5 snapshots on normal flights and up to 7 on long-haul flights.
WEATHER_ARCHIVE_MAX_MB=100

# Edge extension -> tracker schedule/jumpseat sync bearer token.
# Leave blank to disable schedule sync; otherwise use a long random token.
SCHEDULE_SYNC_TOKEN=
